# WooCommerce REST API
NEXT_PUBLIC_WOOCOMMERCE_STORE_URL=https://yourstore.com
NEXT_PUBLIC_WOOCOMMERCE_CONSUMER_KEY=ck_your_consumer_key
NEXT_PUBLIC_WOOCOMMERCE_CONSUMER_SECRET=cs_your_consumer_secret

# NextAuth
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

# Admin emails (comma-separated)
ADMIN_EMAILS=admin@example.com

# Admin password for login
ADMIN_PASSWORD=your_secure_admin_password

# Cron secret (for protected cron endpoints)
CRON_SECRET=your_random_cron_secret

# Price Tracker
PRICE_CHECK_INTERVAL_HOURS=6
ALERT_THRESHOLD=10
LOW_STOCK_THRESHOLD=10

# Resend (Email notifications)
RESEND_API_KEY=re_your_resend_api_key
NOTIFICATION_EMAIL_FROM=noreply@yourdomain.com

# Twilio WhatsApp (optional)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
ENABLE_WHATSAPP=false
ADMIN_WHATSAPP=+971501234567

# OpenAI (AI pricing suggestions)
OPENAI_API_KEY=sk-your_openai_api_key
AI_CONFIDENCE_THRESHOLD=85

# Resend (Email notifications)
RESEND_API_KEY=re_your_resend_api_key
NOTIFICATION_EMAIL_FROM=noreply@yourdomain.com

# Twilio WhatsApp (optional)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# OpenAI (AI pricing suggestions)
OPENAI_API_KEY=sk-your_openai_api_key

# App
APP_NAME=Gaming PC Store
SUPPORT_EMAIL=support@yourdomain.com

# Price Tracker
PRICE_CHECK_INTERVAL_HOURS=6
COMPETITOR_WEBSITES=https://competitor1.com,https://competitor2.com

# Cron secret (for protected cron endpoints)
CRON_SECRET=your_random_cron_secret
